<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The bridge may use plain HTTP on the LAN/VPN, or HTTPS with a
         self-signed certificate. User-installed CAs (e.g. mkcert) are also
         trusted so a proper certificate can be used. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
