{
  "name": "opencode-remote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Android remote control for the OpenCode Desktop GUI (shared background service).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "icons": "node scripts/gen-icons.mjs",
    "detect": "node scripts/detect-opencode.mjs",
    "bridge": "node bridge/src/index.ts",
    "bridge:secure": "node bridge/src/index.ts --tls",
    "tray": "powershell -ExecutionPolicy Bypass -File tray/opencode-remote-tray.ps1",
    "start-all": "powershell -ExecutionPolicy Bypass -File tray/start-all.ps1",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "test:app": "node --test test/format.test.mjs test/tools.test.mjs",
    "test:bridge": "node --test bridge/test/sse.test.mjs bridge/test/config.test.mjs bridge/test/server.test.mjs",
    "test": "npm run test:app && npm run test:bridge",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@ionic/react": "^9.0.6",
    "@ionic/react-router": "^9.0.6",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "diff": "^9.0.0",
    "ionicons": "^8.1.0",
    "jsqr": "^1.4.0",
    "motion": "^13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^6.30.1",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
